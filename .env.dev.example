# Database
POSTGRES_DB=subscription_tracker_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password

# Backend
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
CORS_ALLOWED_ORIGINS=http://localhost:8889,http://localhost:5173

# External APIs
FX_RATE_API_KEY=your_api_key_here

# Two-Factor Authentication (2FA)
# Encryption key for TOTP secrets (min 32 chars, generate with: openssl rand -base64 32)
TOTP_ENCRYPTION_KEY=dev-key-change-in-prod-must-be-32-chars

# Development options
JAVA_DEBUG=true
DEVTOOLS_ENABLED=true
LOG_LEVEL_APP=DEBUG
EXPOSE_POSTGRES=true

# Frontend
VITE_API_BASE_URL=http://localhost:8889/api
