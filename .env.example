# Subscription Tracker - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database Configuration (optional - defaults shown)
POSTGRES_DB=subscription_tracker
POSTGRES_USER=subscription_user

# Database Password (REQUIRED)
POSTGRES_PASSWORD=your_secure_password_here

# JWT Secret for authentication (REQUIRED)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters

# CORS Allowed Origins (optional - for production deployments)
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# Exchange Rate API Key (optional - for multi-currency support)
# Get free key at: https://www.exchangerate-api.com/
FX_RATE_API_KEY=your_api_key_here
