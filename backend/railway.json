{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "./gradlew clean build -x test --no-daemon"
  },
  "deploy": {
    "startCommand": "java -Xmx256m -Xms128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=40m -XX:MaxDirectMemorySize=16m -XX:TieredStopAtLevel=1 -jar build/libs/*.jar",
    "healthcheckPath": "/api/v1/actuator/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
